{
  "name": "litscout",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./test/*": "./test/*.ts"
  },
  "bin": {
    "litscout": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:eval": "node scripts/eval.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@litscout/core": "workspace:*",
    "@litscout/db": "workspace:*",
    "@litscout/mcp": "workspace:*",
    "@litscout/pipeline": "workspace:*",
    "@litscout/sources": "workspace:*",
    "@litscout/sync": "workspace:*",
    "csv-parse": "^7.0.3",
    "jiti": "^2.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "pdfjs-dist": "6.5.438",
    "ulid": "^3.0.0",
    "zod": "4.6.7"
  }
}
