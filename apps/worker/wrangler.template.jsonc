{
  "name": "your-worker-name",
  "main": "dist/bundle/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": { "PUBLIC_URL": "https://YOUR_WORKER_HOST" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-worker-name-db",
      "database_id": "YOUR_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "KV_NAMESPACE_ID" }],
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE_LIMITER", "class_name": "SourceLimiter" },
      { "name": "PAIRING_STORE", "class_name": "PairingStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SourceLimiter", "PairingStore"] },
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "triggers": { "crons": ["0 2 * * *"] },
  "send_metrics": false,
}
