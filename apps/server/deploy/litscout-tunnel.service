[Unit]
Description=Cloudflare Tunnel connector for LitScout (its own tunnel)
After=network-online.target litscout-server.service
Wants=network-online.target
ConditionPathExists=/home/litscout/litscout/etc/tunnel.token

[Service]
Type=simple
User=litscout
Group=litscout
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:0 run --token-file /home/litscout/litscout/etc/tunnel.token
Restart=on-failure
RestartSec=15
MemoryMax=200M
CPUQuota=50%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
