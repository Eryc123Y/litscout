{
  "name": "litscout-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.artifacts/test-results.json",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=.artifacts/test-results.json && node tools/coverage-report.mjs",
    "build": "node tools/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:e2e && pnpm format:check && node tools/audit.mjs",
    "verify": "pnpm audit --audit-level high && pnpm check && node apps/cli/scripts/worker-smoke.mjs && node apps/cli/scripts/cli-smoke.mjs && node --import tsx tools/rehearsal.mjs",
    "test:worker": "pnpm build && node apps/cli/scripts/worker-smoke.mjs && node apps/cli/scripts/cli-smoke.mjs",
    "test:migrations": "vitest run packages/db/test/migrations.test.ts",
    "web:local": "tsx tools/local-web.ts",
    "web:demo": "LITSCOUT_DEMO=1 tsx tools/local-web.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@litscout/core": "workspace:*",
    "@litscout/db": "workspace:*",
    "@litscout/mcp": "workspace:*",
    "@litscout/sources": "workspace:*",
    "@litscout/worker": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.12.0",
    "hono": "^4.0.0",
    "jiti": "^2.0.0",
    "jose": "^6.0.0",
    "litscout": "workspace:*",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ulid": "^3.0.0",
    "wrangler": "4.151.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "better-sqlite3": "^12.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "jsdom": "26.1.0",
    "miniflare": "5.20261012.0-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0",
    "vitest": "5.0.3"
  }
}
